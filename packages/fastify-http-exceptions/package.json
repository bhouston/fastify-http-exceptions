{
  "name": "fastify-http-exceptions",
  "version": "1.3.0",
  "description": "A Fastify plugin and core utilities for typed HTTP exceptions and responses.",
  "keywords": [
    "error",
    "exceptions",
    "fastify",
    "http",
    "nodejs",
    "plugin",
    "typescript"
  ],
  "homepage": "https://github.com/bhouston/fastify-http-exceptions#readme",
  "bugs": {
    "url": "https://github.com/bhouston/fastify-http-exceptions/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/fastify-http-exceptions"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "node-mocks-http": "^1.18.1"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
